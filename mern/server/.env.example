PORT=5000

# Local MongoDB, or your Atlas connection string. NEVER commit real credentials here.
MONGO_URI=mongodb+srv://adminuser:T5FKstKyAAxvONQ6@applyflowcluster.plevbhn.mongodb.net/?appName=ApplyFlowCluster

# Comma-separated list of exact frontend origins allowed to call the API.
CLIENT_ORIGINS=http://localhost:5173

# Set to 1 when running behind a proxy/CDN (Vercel, Render, Nginx) so rate
# limiting sees the real visitor IP.
TRUST_PROXY=0

# Generate two DIFFERENT secrets (each run prints a fresh value):
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_KEY=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_SESSION_SECRET=replace-with-a-different-random-secret-of-32-plus-chars

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio
